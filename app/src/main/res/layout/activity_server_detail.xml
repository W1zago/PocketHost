<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            app:title="Server Details"
            app:titleTextColor="@color/on_surface"
            app:navigationIconTint="@color/on_surface" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Hero card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/serverIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_box"
                            android:gravity="center"
                            android:text="M"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/tertiary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/serverName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Server Name"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface"
                                android:ellipsize="end"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/serverType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Type"
                                android:textSize="11sp"
                                android:textColor="@color/on_surface_variant"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/statusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_status_idle"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_idle" />

                            <TextView
                                android:id="@+id/serverStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Stopped"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/badge_idle_fg"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/serverPort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":25565"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary"
                            android:fontFamily="monospace"
                            android:background="@drawable/bg_port_chip"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                        <TextView
                            android:id="@+id/serverUptime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Up —"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="monospace" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/serverIpAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="…"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />

                    <TextView
                        android:id="@+id/serverFolderPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Folder: …"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />

                    <TextView
                        android:id="@+id/tvErrorMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/error"
                        android:fontFamily="monospace"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Section tabs: real navigation (scroll or open screen) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tabOverview"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Overview"
                            android:textSize="12sp"
                            style="@style/PocketHost.Button.Tonal" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tabConsole"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:text="Console"
                            android:textSize="12sp"
                            style="@style/PocketHost.Button.Tonal" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tabFiles"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:text="Files"
                            android:textSize="12sp"
                            style="@style/PocketHost.Button.Tonal" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tabTelemetry"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:text="Telemetry"
                            android:textSize="12sp"
                            style="@style/PocketHost.Button.Tonal" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tabConfig"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:text="Config"
                            android:textSize="12sp"
                            style="@style/PocketHost.Button.Tonal" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- Live telemetry bento (device-real values, 2s poll) -->
                <LinearLayout
                    android:id="@+id/resourcesCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="LIVE TELEMETRY"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2s poll"
                            android:textSize="10sp"
                            android:textColor="@color/tertiary"
                            android:fontFamily="monospace" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_telemetry_strip"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UPTIME"
                                android:textSize="10sp"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/tileUptime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="—"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_telemetry_strip"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="APP HEAP"
                                android:textSize="10sp"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/tileMemory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="—"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/secondary"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_telemetry_strip"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CPU CORES"
                                android:textSize="10sp"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/tileCores"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="—"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_telemetry_strip"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DISK FREE"
                                android:textSize="10sp"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/tileDisk"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="—"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/tertiary"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Network & binding (real LAN IP + port) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NETWORK &amp; BINDING"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="monospace" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvBindAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="…"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:text="Copy"
                            android:textSize="12sp"
                            style="@style/PocketHost.Button.Tonal" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0.0.0.0 • TCP — reachable on local Wi-Fi"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant" />

                </LinearLayout>

                <!-- Console stream preview (real tail of server.log) -->
                <LinearLayout
                    android:id="@+id/logCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CONSOLE STREAM"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvLogLive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● LIVE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/tertiary"
                            android:fontFamily="monospace" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLogPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_telemetry_strip"
                        android:padding="10dp"
                        android:text="Waiting for log…"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface"
                        android:fontFamily="monospace"
                        android:maxLines="10"
                        android:ellipsize="end" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenTerminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Open Interactive Terminal"
                        android:textSize="13sp"
                        style="@style/PocketHost.Button.Tonal" />

                </LinearLayout>

                <!-- Minecraft settings -->
                <LinearLayout
                    android:id="@+id/minecraftSettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Minecraft Settings"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPirate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Allow cracked (non-premium) players" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Disables Mojang license check (online-mode=false)."
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/tvViewDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="View distance: 10 chunks"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderViewDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="10"
                        android:valueFrom="2"
                        android:valueTo="32"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/tvSettingsHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="On a stopped server applies immediately, on a running one — after restart."
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant" />

                </LinearLayout>

                <!-- Ubuntu settings -->
                <LinearLayout
                    android:id="@+id/ubuntuSettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ubuntu 22.04 (proot)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/tvUbuntuStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Checking…"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="monospace" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstallUbuntu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Download Ubuntu (~30MB)"
                        android:textSize="13sp"
                        style="@style/PocketHost.Button.Tonal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Full user-space Ubuntu with apt. Without it the server runs the built-in shell. Start also downloads automatically. Essential packages (python3, nodejs, git...) install in background on first start."
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant" />

                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStart"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/start"
                        style="@style/PocketHost.Button.Start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/stop"
                        style="@style/PocketHost.Button.Destructive" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestart"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/restart"
                        style="@style/PocketHost.Button.Tonal" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConsole"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/console"
                        style="@style/PocketHost.Button.Tonal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFiles"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/files"
                        style="@style/PocketHost.Button.Tonal" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/delete"
                    style="@style/PocketHost.Button.Destructive" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
