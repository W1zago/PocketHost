<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header (design: single 56dp row — back, name + status pill,
             direct Copy/Share/Clear actions, overflow for the rest).
             No "issues" chip (collides in mockup, no such feature);
             no fake runtime subtitle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_lowest"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/statusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_status_idle"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_dot_idle" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Stopped"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/badge_idle_fg"
                            android:fontFamily="@font/jetbrains_mono_family" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvServerName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="server"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:fontFamily="@font/jetbrains_mono_family"
                        android:ellipsize="end"
                        android:maxLines="1" />

                </LinearLayout>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="8dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="Copy log"
                android:src="@drawable/ic_content_copy"
                app:tint="@color/on_surface_variant" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:padding="8dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="Share log"
                android:src="@drawable/ic_share"
                app:tint="@color/on_surface_variant" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:padding="8dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="Clear console"
                android:src="@drawable/ic_delete"
                app:tint="@color/on_surface_variant" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More actions"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/on_surface_variant" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline_variant" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.pockethost.app.ui.ConsoleScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls"
                android:background="@android:color/transparent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <!-- Terminal surface (Termux-style): typing happens inline here,
                     right after the prompt. NOTE: never put layout_gravity
                     on this child: bottom gravity on a taller-than-viewport
                     child collapses the scroll range to ~0 (bottom-aligned,
                     top goes negative). Short logs are pinned low via
                     minimumHeight + text gravity instead (updateFastThumb). -->
                <EditText
                    android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/jetbrains_mono_family"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline"
                    android:hint="Tap here to type…"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp"
                    android:lineSpacingMultiplier="1.0"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:justificationMode="none"
                    android:fontFeatureSettings="tnum"
                    android:gravity="bottom"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:longClickable="true"
                    android:contextClickable="true"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
                    android:imeOptions="actionSend" />

            </com.pockethost.app.ui.ConsoleScrollView>

            <!-- Draggable fast-scroll strip (right edge): finger drag here
                 jumps/scrolls the log directly. The thumb height reflects
                 viewport/content ratio; hidden when there is nothing to scroll. -->
            <FrameLayout
                android:id="@+id/fastScrollTrack"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clipChildren="false"
                android:background="@android:color/transparent">

                <!-- Faint full-height rail so the drag zone is discoverable. -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/outline_variant"
                    android:alpha="0.5" />

                <View
                    android:id="@+id/fastScrollThumb"
                    android:layout_width="8dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_fast_scroll_thumb"
                    android:alpha="0.9" />

            </FrameLayout>

            <!-- Scroll helper overlay: appears only while reading history
                 (follow paused). Slim single row, bottom-anchored, so it
                 covers as little of the log as possible. -->
            <LinearLayout
                android:id="@+id/scrollOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToTop"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="↑ Top"
                        android:textSize="12sp"
                        style="@style/PocketHost.Button.Tonal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToBottom"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="↓ Bottom"
                        android:textSize="12sp"
                        style="@style/PocketHost.Button.Start" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/extraKeysPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/keyEsc"
                    style="@style/ExtraKey"
                    android:text="ESC" />
                <TextView
                    android:id="@+id/keySlash"
                    style="@style/ExtraKey"
                    android:text="/" />
                <TextView
                    android:id="@+id/keyDash"
                    style="@style/ExtraKey"
                    android:text="—" />
                <TextView
                    android:id="@+id/keyHome"
                    style="@style/ExtraKey"
                    android:text="HOME" />
                <TextView
                    android:id="@+id/keyUp"
                    style="@style/ExtraKey"
                    android:text="↑" />
                <TextView
                    android:id="@+id/keyEnd"
                    style="@style/ExtraKey"
                    android:text="END" />
                <TextView
                    android:id="@+id/keyPgUp"
                    style="@style/ExtraKey"
                    android:text="PGUP" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/keyTab"
                    style="@style/ExtraKey"
                    android:text="TAB" />
                <TextView
                    android:id="@+id/keyCtrl"
                    style="@style/ExtraKey"
                    android:text="CTRL" />
                <TextView
                    android:id="@+id/keyAlt"
                    style="@style/ExtraKey"
                    android:text="ALT" />
                <TextView
                    android:id="@+id/keyLeft"
                    style="@style/ExtraKey"
                    android:text="←" />
                <TextView
                    android:id="@+id/keyDown"
                    style="@style/ExtraKey"
                    android:text="↓" />
                <TextView
                    android:id="@+id/keyRight"
                    style="@style/ExtraKey"
                    android:text="→" />
                <TextView
                    android:id="@+id/keyPgDn"
                    style="@style/ExtraKey"
                    android:text="PGDN" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
