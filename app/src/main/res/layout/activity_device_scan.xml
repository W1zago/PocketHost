<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            app:title="Device Scan"
            app:titleTextColor="@color/on_surface"
            app:titleTextAppearance="@style/PocketHost.ToolbarTitle"
            app:navigationIconTint="@color/on_surface" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="24dp">

                <!-- Sub-header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HOST DIAGNOSTIC CHECK"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="@font/jetbrains_mono_family" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="System Health"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="PRoot Linux &amp; Android Environment"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/diagnosticsChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIAGNOSTICS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:fontFamily="@font/jetbrains_mono_family"
                        android:background="@drawable/bg_port_chip"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                </LinearLayout>

                <!-- System health summary (real pass counts) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYSTEM HEALTH"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="@font/jetbrains_mono_family" />

                    <TextView
                        android:id="@+id/healthTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Checking…"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/healthSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/healthStatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/jetbrains_mono_family"
                        android:background="@drawable/bg_port_chip"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Pre-flight warning (real state: shown only when issues exist) -->
                <LinearLayout
                    android:id="@+id/warnCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/warning"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pre-Flight Bottlenecks Detected"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Resolve system dependencies and permissions to ensure background server stability."
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Checklist header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="INSPECTION CHECKLIST (8 COMPONENTS)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="@font/jetbrains_mono_family" />

                    <TextView
                        android:id="@+id/autoCheckAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="10sp"
                        android:textColor="@color/tertiary"
                        android:fontFamily="@font/jetbrains_mono_family" />

                </LinearLayout>

                <!-- Rows are inflated from item_device_check.xml (same 8 checks) -->
                <LinearLayout
                    android:id="@+id/checkContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Note: SAF folders and RUN_COMMAND are no longer used. Old SAF servers start in migration mode in the internal folder."
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_variant" />

                <!-- App updates (optional, never forced) -->
                <LinearLayout
                    android:id="@+id/updateCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_section_card"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APP VERSION (OPTIONAL)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="@font/jetbrains_mono_family" />

                    <TextView
                        android:id="@+id/updateTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Checking…"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/updateSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <ProgressBar
                        android:id="@+id/updateProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCheckUpdate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="Check for updates"
                            android:textSize="12sp"
                            android:maxLines="2"
                            style="@style/PocketHost.Button.Tonal" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstallUpdate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:text="Install"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:visibility="gone"
                            style="@style/PocketHost.Button.Start" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Bottom bar: rescan + auto-grant (own space, never overlaps content) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface_lowest"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRescan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Scan again"
                android:textSize="13sp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/on_surface"
                style="@style/PocketHost.Button.Tonal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoGrant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="Grant permissions"
                android:textSize="13sp"
                app:icon="@drawable/ic_shield"
                style="@style/PocketHost.Button.Start" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
