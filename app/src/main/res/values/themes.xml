<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PocketHost dark theme. Name kept (referenced from AndroidManifest). -->
    <style name="Theme.PocketHost" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface_lowest</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Design fonts: Inter for UI, JetBrains Mono for technical data. -->
        <item name="android:fontFamily">@font/inter_family</item>
        <item name="fontFamily">@font/inter_family</item>
    </style>

    <!-- Reusable PocketHost components (rounded per design: cards 16dp, controls 8dp, pills full) -->
    <style name="PocketHost.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_container</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="PocketHost.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PocketHost.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_high</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/surface_highest</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="PocketHost.Button.Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/badge_error_bg</item>
        <item name="android:textColor">@color/error</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/error_container</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="PocketHost.Button.Start" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PocketHost.Search" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_high</item>
        <item name="boxStrokeColor">@color/outline_variant</item>
        <item name="hintTextColor">@color/on_surface_variant</item>
    </style>

    <style name="PocketHost.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- Toolbar title per design: Inter 18sp semibold (headline-sm). -->
    <style name="PocketHost.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">@font/inter_family</item>
    </style>

    <!-- Console header title: JetBrains Mono 14sp bold (server name). -->
    <style name="PocketHost.ToolbarTitle.Mono" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">@font/jetbrains_mono_family</item>
    </style>

    <!-- (PocketHost.Chip.Level removed with the console level chips.) -->

    <style name="ExtraKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/bg_extra_key</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">@font/jetbrains_mono_family</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="ExtraKey.Active">
        <item name="android:background">@drawable/bg_extra_key_active</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Quick-command pill (design: container bg, 6dp, mono 11, touch 48). -->
    <!-- (PocketHost.Button.Pill removed with the console quick pills.) -->

</resources>
