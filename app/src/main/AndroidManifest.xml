<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Довільна папка сервера (опційно, лише за вибором користувача):
         на Android 11+ потрібен доступ до всіх файлів (системні налаштування),
         на старіших — класичний WRITE_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Вбудований термінал: зовнішній Termux більше не потрібен,
         дозвіл com.termux.permission.RUN_COMMAND прибрано щоб система
         не просила "керування / ввід команд в Termux". -->

    <application
        android:name=".ANServerApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.ANServer"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ANServer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ServerDetailActivity"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.CreateServerActivity"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.FileManagerActivity"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ConsoleActivity"
            android:parentActivityName=".ui.ServerDetailActivity" />

        <activity
            android:name=".termux.TermuxHardGateActivity"
            android:exported="false"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ANServer" />

        <activity
            android:name=".termux.DeviceScanActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.ANServer" />

        <service
            android:name=".service.ServerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Legacy Termux callback, лишено для сумісності старих встановлень.
             Не вимагає RUN_COMMAND, не використовується вбудованим терміналом. -->
        <service
            android:name=".termux.TermuxResultsService"
            android:enabled="true"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
