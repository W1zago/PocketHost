{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "adb devices": "allow",
      "adb logcat *": "allow",
      "adb shell getprop *": "allow",
      "adb shell dumpsys *": "allow",
      "adb shell uiautomator dump": "allow",
      "adb shell input tap *": "allow",
      "adb shell input swipe *": "allow",
      "adb shell input text *": "allow",
      "adb shell input keyevent *": "allow",
      "adb shell am start *": "allow",
      "git *": "allow",
      "gradle *": "ask",
      "adb install *": "ask",
      "adb uninstall *": "ask",
      "adb shell rm *": "deny",
      "adb shell mv *": "deny"
    },
    "edit": {
      "*": "ask"
    }
  }
}
